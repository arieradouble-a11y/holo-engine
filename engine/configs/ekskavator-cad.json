  "parts": [
    {
      "key": "part00",
      "name": "Кузов, кабина, двигатель",
      "tag": "ТЕЛО МАШИНЫ",
      "desc": "Несущий корпус, который у этой машины работает и рамой, кабина с круговым остеклением и поворотным сиденьем, капот с решёткой радиатора и выхлопной трубой, задняя стойка навески и выносные опоры — здесь они ОПУЩЕНЫ на грунт, то есть машина стоит не на колёсах."
    },
    {
      "key": "part01",
      "name": "Колёса",
      "tag": "ХОДОВАЯ ЧАСТЬ",
      "desc": "Задние колёса заметно крупнее передних: на них тяга и на них же приходится вес при копании, передние — управляемые. При работе задней стрелой колёса разгружены выносными опорами."
    },
    {
      "key": "part02",
      "name": "Фронтальный погрузчик",
      "tag": "ПЕРЕДНЕЕ ОБОРУДОВАНИЕ",
      "desc": "Стрела с цилиндрами подъёма и опрокидывания, коромысло с тягой и ковш с режущей кромкой. Им грузят отвал, чистят площадку и засыпают траншею обратно — а при копании задней стрелой он опущен на грунт и работает УПОРОМ."
    },
    {
      "key": "gidro",
      "name": "Гидросистема",
      "tag": "ПРИВОД ВСЕГО",
      "desc": "Гидробак с сапуном и указателем уровня, насос на отборе мощности, шестисекционный распределитель, фильтр слива и рукава высокого давления к каждому цилиндру. Всё, что машина делает, делает гидравлика."
    },
    {
      "key": "back",
      "name": "Экскаваторное оборудование",
      "tag": "ЗАДНЕЕ ОБОРУДОВАНИЕ",
      "desc": "Двухзвенная стрела на задней стойке, рукоять, три цилиндра и ковш обратной лопаты с зубьями. Копает НА СЕБЯ — поэтому стенка траншеи получается почти вертикальной, а глубина ограничена вылетом рукояти."
    },
    {
      "key": "svet",
      "name": "Освещение и сигнализация",
      "tag": "БЕЗОПАСНОСТЬ",
      "desc": "Проблесковый маяк, рабочие фары вперёд и назад, фары на решётке, задние габариты и знак тихоходного транспортного средства."
    },
    {
      "key": "grunt",
      "name": "Траншея и ограждение",
      "tag": "МЕСТО РАБОТ",
      "desc": "Вскрытое дорожное покрытие, стенки и дно траншеи, две трубы в изоляции на дне, отвал вынутого грунта вдоль края, сигнальные стойки с лентой и знак «ведутся работы»."
    }
  ],
