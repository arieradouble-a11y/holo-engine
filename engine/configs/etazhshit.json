  "parts": [
    {
      "key": "stena",
      "name": "Стены и перекрытия",
      "tag": "РАЗРЕЗ ЭТАЖА",
      "desc": "Плиты перекрытия снизу и сверху, стена лестничной площадки, межквартирная стена с дверным проёмом и полотном входной двери, стена квартиры. Показаны разрезом: сплошной короб в аддитивном каркасе спрятал бы всё, что внутри."
    },
    {
      "key": "stoyak",
      "name": "Электрический стояк",
      "tag": "МАГИСТРАЛЬ",
      "desc": "Магистраль от вводного устройства дома через все этажи: три жилы в кабельном коробе, гильзы в перекрытиях, ответвительные сжимы и бирка с номером стояка и подъезда. Ответвление делают, не разрезая магистраль."
    },
    {
      "key": "shchit",
      "name": "Этажный щит",
      "tag": "ОБЩЕЕ ИМУЩЕСТВО",
      "desc": "Корпус с дверцей, смотровым окном, ригельным замком и пломбой управляющей организации, три DIN-рейки, клеммы транзита стояка, вводные автоматы квартир, маркировочная полоса и шины рабочего нуля и защитного проводника."
    },
    {
      "key": "uchet",
      "name": "Учёт на площадке",
      "tag": "ОТКУДА ОДН",
      "desc": "Четыре квартирных счётчика с отсчётными устройствами, шильдиками и пломбами поверки, испытательная коробка. Сумма их показаний, вычтенная из общедомового, и даёт строку ОДН."
    },
    {
      "key": "kvshit",
      "name": "Квартирный щиток",
      "tag": "ЗОНА СОБСТВЕННИКА",
      "desc": "Вводной двухполюсный автомат, УЗО на 30 мА, квартирный счётчик, шесть групповых автоматов с подписями, шины рабочего нуля и защитного проводника за прозрачной дверцей."
    },
    {
      "key": "linii",
      "name": "Групповые линии",
      "tag": "ПРОВОДКА",
      "desc": "Кабели групп по стене, распаячная коробка со снимаемой крышкой и клеммниками, отдельная линия на кухню и фрагмент старой алюминиевой двухпроводки со скруткой в коробке."
    },
    {
      "key": "tochki",
      "name": "Розетки и выключатель",
      "tag": "ТОЧКИ",
      "desc": "Подрозетники в стене, розетки с заземляющим контактом, кухонная розетка на рабочей высоте, выключатель освещения и старая розетка без защитного контакта — для сравнения."
    },
    {
      "key": "svet",
      "name": "Освещение",
      "tag": "СВЕТ",
      "desc": "Потолочный светильник квартиры на своей линии через выключатель и светильник лестничной площадки, питающийся из этажного щита по линии общедомовых нужд."
    },
    {
      "key": "zemlya",
      "name": "Защитный проводник",
