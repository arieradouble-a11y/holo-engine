  "parts": [
    {
      "key": "part00",
      "name": "Шасси и ходовая",
      "tag": "ПНЕВМОКОЛЁСНЫЙ ХОД",
      "desc": "Рама специального шасси, два моста со сдвоенными колёсами, рулевая трапеция, подвеска и сцепное устройство. Ход у такого крана свой, не грузовой: он рассчитан не на скорость, а на то, чтобы въехать во двор и встать."
    },
    {
      "key": "part01",
      "name": "Выносные опоры",
      "tag": "ОПОРНЫЙ КОНТУР",
      "desc": "Четыре балки с гидроцилиндрами и подпятниками, выдвинутые на полную. Именно они, а не колёса, держат машину при подъёме: опорный контур 5,1 × 4,1 м — это площадь, на которую опирается весь опрокидывающий момент."
    },
    {
      "key": "part02",
      "name": "Поворотная платформа",
      "tag": "ПОВОРОТ И ПРОТИВОВЕС",
      "desc": "Надстройка с двигателем, лебёдками и противовесом на опорно-поворотном устройстве. Противовес уравновешивает груз на вылете — поэтому корма крана выступает за габарит и при повороте описывает свою опасную зону."
    },
    {
      "key": "part03",
      "name": "Кабина крановщика",
      "tag": "РАБОЧЕЕ МЕСТО",
      "desc": "Кабина на поворотной платформе с остеклением, люками, рычагами и педалями. Крановщик смотрит на груз снизу вверх и почти всегда работает по командам стропальщика — отсюда жёсткие правила сигналов и запрет работать «на глазок»."
    },
    {
      "key": "part04",
      "name": "Стрела",
      "tag": "ВЫЛЕТ",
      "desc": "Решётчатая стрела базовой длины на большом вылете. Решётка — не украшение: при равной жёсткости она втрое легче сплошной балки, а собственный вес стрелы вычитается из грузоподъёмности."
    },
    {
      "key": "osnastka",
      "name": "Грузовая оснастка",
      "tag": "КАНАТ И КРЮК",
      "desc": "Блок оголовка, грузовой канат в две нитки полиспаста, крюковая обойма с блоками, вертлюгом и предохранительным замком, четырёхветвевой строп со скобами. Полиспаст делит нагрузку на канат — и во столько же раз замедляет подъём."
    },
