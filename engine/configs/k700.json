  "parts": [
    {
      "key": "part00",
      "name": "Полурамы, кабина, двигатель",
      "tag": "ШАРНИРНО-СОЧЛЕНЁННЫЙ",
      "desc": "Две полурамы, соединённые вертикальным шарниром, кабина над передним мостом и двигатель в носу. Машина поворачивает СКЛАДЫВАЯСЬ, а не колёсами: на рыхлых отходах это выигрыш — все четыре колеса идут по одной колее и не вывешиваются."
    },
    {
      "key": "part01",
      "name": "Колёса",
      "tag": "РАСХОДНИК",
      "desc": "Четыре одинаковых ведущих колеса диаметром 1,7 м. На полигоне это самая быстро изнашиваемая часть: битое стекло, арматура и проволока режут шину, и комплект живёт заметно меньше, чем на поле."
    },
    {
      "key": "part02",
      "name": "Трансмиссия",
      "tag": "ПРИВОД",
      "desc": "Карданная передача на оба моста. Полный привод здесь обязателен: сцепление с рыхлым слоем отходов почти никакое, и машина идёт «внатяг», а не за счёт скорости."
    },
    {
      "key": "part03",
      "name": "Бульдозерное оборудование",
      "tag": "ОТВАЛ",
      "desc": "Толкающая рама, криволинейный щит шириной четыре метра с рёбрами и боковыми щеками, нож со сменными накладками, отбойник поверху и гидроцилиндры подъёма. Отвал не копает, а надвигает и разравнивает рыхлую массу."
    },
    {
      "key": "part04",
      "name": "Рабочая карта",
      "tag": "СЛОИ И УПЛОТНЕНИЕ",
