  "parts": [
    {
      "key": "truba",
      "name": "Трубопровод и опоры",
      "tag": "КОНТЕКСТ",
      "desc": "Прямые участки до и после клапана, фланцы со шпильками, опоры с хомутами, стрелка направления среды и бирка контура. Без прямых участков расчётная характеристика клапана «плывёт»."
    },
    {
      "key": "klap",
      "name": "Корпус клапана",
      "tag": "ОТЛИВКА",
      "desc": "Проходной седельный корпус с внутренней расточкой, горловиной, фланцем под крышку и рёбрами. S-образная траектория потока через седло и создаёт тот перепад, на котором клапан регулирует."
    },
    {
      "key": "sedlo",
      "name": "Седло",
      "tag": "ПРОХОД",
      "desc": "Сменное седло с посадочным буртом. Пара «седло — плунжер» и есть регулирующий орган; износ седла превращает клапан в неплотный кран, который уже не держит закрытие."
    },
    {
      "key": "plunzher",
      "name": "Плунжер",
      "tag": "ХАРАКТЕР.",
      "desc": "Профильный плунжер с направляющими рёбрами и хвостовиком. Его форма задаёт характеристику: у равнопроцентного каждый миллиметр хода добавляет одинаковый процент расхода."
    },
    {
      "key": "salnik",
      "name": "Сальник и крышка",
      "tag": "УПЛОТНЕНИЕ",
      "desc": "Крышка с сальниковой камерой, кольца набивки, нажимная втулка со шпильками. Единственный узел, обслуживаемый на месте: подтяжка втулки снимает течь по штоку."
    },
    {
      "key": "privod",
      "name": "Электропривод",
      "tag": "ПРИВОД",
      "desc": "Корпус с винтовой парой, отсек двигателя с рёбрами охлаждения, клеммный отсек с силовым и сигнальным вводами. Тянет шток линейно и ограничен по усилию."
    },
    {
      "key": "pozic",
      "name": "Позиционер",
      "tag": "СИГНАЛ",
      "desc": "Корпус с индикатором и кнопками, рычаг обратной связи и датчик положения. Держит шток в положении, заданном сигналом 4–20 мА, компенсируя трение сальника."
    },
    {
      "key": "ruchnoe",
      "name": "Дублёр и указатель",
      "tag": "РУЧНОЕ",
      "desc": "Маховик ручного дублёра со спицами, рычаг перевода режима, указатель хода на штоке и шкала на фонаре. Положение клапана читается глазом, без диспетчерской."
    }
  ],
